---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>
  <main
    class="w-full max-w-xl mx-auto px-6 flex flex-col items-start text-left animate-fade-in"
  >
    <h1
      class="mb-8 -ml-[0.04em] font-sans text-blue-400 font-black tracking-tight text-3xl sm:text-4xl leading-none [text-box:trim-both_cap_alphabetic]"
      style="text-shadow: rgba(59, 130, 246, 0.6) 0px 0px 8px;"
    >
      CodeBlueLife
    </h1>

    <p
      class="text-zinc-300 text-base sm:text-lg leading-relaxed mb-10 font-normal"
    >
      A modern FiveM framework.
    </p>
  </main>
</MainLayout>
