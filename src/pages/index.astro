---
import MainLayout from "../layouts/MainLayout.astro";
import SocialNav from "./_components/landing-page/SocialNav.astro";
---

<MainLayout>
  <main
    class="w-full max-w-xl mx-auto px-6 flex flex-col items-start text-left animate-fade-in"
  >
    <div class="mb-8 flex items-center gap-4">
      <div
        class="h-16 w-16 shrink-0 flex items-center justify-center overflow-hidden rounded-xl border border-zinc-800 bg-[#0b0b1a]"
      >
        <img
          src="/assets/224341111 (1).png"
          alt="CodeBlueLife"
          class="h-[110px] w-[110px] max-w-none mix-blend-screen drop-shadow-[0_0_10px_rgba(148,163,255,0.4)]"
        />
      </div>

      <div class="flex flex-col gap-1">
        <span
          class="font-display font-extrabold text-white uppercase tracking-[0.18em] text-lg leading-none"
        >
          CodeBlueLife
        </span>
        <span
          class="text-zinc-500 uppercase tracking-[0.2em] text-xs leading-none"
        >
          A Venoxity company
        </span>
      </div>
    </div>

    <p
      class="text-zinc-300 text-base sm:text-lg leading-relaxed mb-10 font-normal"
    >
      We are currently working hard behind the scenes to craft a new generation
      of immersive experiences and innovative tooling. The new platform will be
      launching soon.
    </p>

    <SocialNav />
  </main>
</MainLayout>
