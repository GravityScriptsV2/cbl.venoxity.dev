---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>
  <main
    class="w-full max-w-xl mx-auto px-6 flex flex-col items-start text-left motion-safe:animate-fade-in"
  >
    <h1
     class="mb-6 -ml-[0.04em] font-sans text-blue-400 font-black tracking-tight text-5xl sm:text-6xl leading-none [text-box:trim-both_cap_alphabetic] [text-shadow:0_0_24px_rgb(59_130_246/0.45)]"
    >
      CodeBlueLife
    </h1>

    <p class="text-foreground/80 text-lg sm:text-xl leading-relaxed mb-10">
      A modern FiveM framework.
    </p>

    <a
      href="https://github.com/CodeBlueLife"
      target="_blank"
      rel="noopener noreferrer"
      class="group inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-white/[0.03] hover:bg-white/[0.07] text-foreground/80 hover:text-white border border-border hover:border-zinc-600 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
    >
      GitHub
      <span
        aria-hidden="true"
        class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        >↗</span
      >
    </a>
  </main>
</MainLayout>
