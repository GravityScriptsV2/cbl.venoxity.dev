---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>
  <main
    class="w-full max-w-xl mx-auto px-6 flex flex-col items-start text-left animate-fade-in"
  >
    <div class="mb-8 flex items-center gap-4">
      <div class="flex flex-col justify-between">
        <span
          class="font-sans text-blue-400 font-black tracking-tight text-3xl sm:text-4xl leading-none [text-box:trim-both_cap_alphabetic]"
          style="text-shadow: rgba(59, 130, 246, 0.6) 0px 0px 8px;"
        >
          CodeBlueLife
        </span>
      </div>
    </div>

    <p
      class="text-zinc-300 text-base sm:text-lg leading-relaxed mb-10 font-normal"
    >
      Lorem ipsum dolor sit amet consectetur adipiscing elit. Amet consectetur
      adipiscing elit quisque faucibus ex sapien. Quisque faucibus ex sapien
      vitae pellentesque sem placerat. Vitae pellentesque sem placerat in id
      cursus mi.
    </p>
  </main>
</MainLayout>
