---
import MainLayout from "../layouts/MainLayout.astro";
import SocialNav from "./_components/landing-page/SocialNav.astro";
---

<MainLayout>
  <main
    class="w-full max-w-xl mx-auto px-6 flex flex-col items-start text-left animate-fade-in"
  >
    <div class="mb-8 flex items-center gap-4">
      <div
        class="h-16 w-16 shrink-0 flex items-center justify-center overflow-hidden rounded-xl border border-zinc-800 bg-[#0b0b1a]"
      >
        <img
          src="/assets/224341111 (1).png"
          alt="CodeBlueLife"
          class="h-[110px] w-[110px] max-w-none mix-blend-screen drop-shadow-[0_0_10px_rgba(148,163,255,0.4)]"
        />
      </div>

      <div class="flex h-16 flex-col justify-between">
  <span
    class="font-sans text-blue-400 font-black tracking-tight text-[56px] leading-none [text-box:trim-both_cap_alphabetic]"
  >
    CodeBlueLife
  </span>
  <span
    class="text-sm leading-none tracking-wide text-zinc-500 [text-box:trim-both_cap_alphabetic]"
  >
    A <span class="text-zinc-300">Venoxity Network</span> company
  </span>
</div>
    </div>

    <p
      class="text-zinc-300 text-base sm:text-lg leading-relaxed mb-10 font-normal"
    >
      Lorem ipsum dolor sit amet consectetur adipiscing elit. Amet consectetur adipiscing elit quisque faucibus ex sapien. Quisque faucibus ex sapien vitae pellentesque sem placerat. Vitae pellentesque sem placerat in id cursus mi.
    </p>

    <SocialNav />
  </main>
</MainLayout>
