---
const year = new Date().getFullYear();
---

<footer class="w-full max-w-xl mx-auto px-6 mt-16">
  <div
    class="pt-6 pb-12 flex flex-col gap-2 border-t border-slate-800 text-xs text-slate-400 leading-relaxed"
  >
    <div class="flex flex-col gap-1.5 text-center sm:text-left">
      <span>
        &copy; {year} <strong class="font-medium text-slate-200">CodeBlueLife</strong>. All rights reserved.
      </span>
      <span class="text-[11.5px] text-slate-500">
        CodeBlueLife is a subsidiary of 
        <a 
          href="https://venoxity.dev" 
          target="_blank"
          rel="noopener noreferrer"
          class="text-slate-300 font-medium underline underline-offset-4 decoration-slate-700 hover:text-sky-400 hover:decoration-sky-400/50 transition-colors"
        >
          Venoxity Network
        </a>, operating as a distinct entity.
      </span>
    </div>
  </div>
</footer>
