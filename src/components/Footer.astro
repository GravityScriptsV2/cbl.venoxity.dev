---
const year = new Date().getFullYear();
---

<footer class="w-full max-w-xl mx-auto px-6 mt-16">
  <div
    class="pt-6 pb-12 flex flex-col items-center sm:items-start gap-2 border-t border-zinc-800/80 text-xs leading-relaxed text-zinc-400"
  >
    <div class="flex flex-col gap-1.5 text-center sm:text-left">
      <p>
        &copy; {year} <strong class="font-semibold text-zinc-200">CodeBlueLife</strong>. All rights reserved.
      </p>
      <p class="text-[12px] text-zinc-500">
        CodeBlueLife is a subsidiary of 
        <a 
          href="https://venoxity.dev" 
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-zinc-400 underline underline-offset-4 decoration-zinc-700 hover:text-blue-400 hover:decoration-blue-400 transition-colors"
        >
          Venoxity Network
        </a>, operating as a distinct entity.
      </p>
    </div>
  </div>
</footer>
