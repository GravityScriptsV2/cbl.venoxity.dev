---
const year = new Date().getFullYear();
const links = [
  { label: "Terms", href: "/terms" },
  { label: "Privacy", href: "/privacy" },
];
---

<footer class="w-full max-w-xl mx-auto px-6">
  <div
    class="pt-5 border-t border-border text-xs leading-relaxed flex flex-col items-start gap-1.5"
  >
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
      <p class="text-foreground/80">
        &copy; {year}
        <strong class="font-semibold text-foreground">CodeBlueLife</strong>.
        All rights reserved.
      </p>
      <nav aria-label="Legal" class="flex items-center gap-4">
        {
          links.map((l) => (
            <a
              href={l.href}
              class="text-muted hover:text-blue-400 transition-colors"
            >
              {l.label}
            </a>
          ))
        }
      </nav>
    </div>

    <p class="text-muted">
      CodeBlueLife is a subsidiary of
      <a
        href="https://venoxity.dev"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-foreground/70 underline underline-offset-4 decoration-zinc-700 hover:text-blue-400 hover:decoration-blue-400/60 transition-colors"
        >Venoxity Network</a
      >, operating as a distinct entity.
    </p>
    <p class="text-[11px] text-muted/70">
      Not affiliated with or endorsed by Rockstar Games, Take-Two Interactive,
      or Cfx.re.
    </p>
  </div>
</footer>
