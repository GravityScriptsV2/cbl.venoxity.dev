---
const year = new Date().getFullYear();
const links = [
  { label: "Terms", href: "/terms" },
  { label: "Privacy", href: "/privacy" },
];
---

<footer class="w-full max-w-xl mx-auto px-6">
  <div
    class="pt-6 border-t border-border text-xs leading-relaxed grid gap-4 sm:grid-cols-[1fr_auto] sm:items-start"
  >
    <div class="flex flex-col gap-1.5">
      <p class="text-foreground/80">
        &copy; {year}
        <strong class="font-semibold text-foreground">CodeBlueLife</strong>.
        All rights reserved.
      </p>
      <p class="text-muted">
        A subsidiary of
        <a
          href="https://venoxity.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-foreground/70 underline underline-offset-4 decoration-zinc-700 hover:text-blue-400 hover:decoration-blue-400/60 transition-colors"
          >Venoxity Network</a
        >, operating as a distinct entity.
      </p>
    </div>

    <nav aria-label="Legal" class="flex items-center gap-4">
      {
        links.map((l) => (
          <a
            href={l.href}
            class="text-muted hover:text-blue-400 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400 rounded-sm"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <p class="sm:col-span-2 pt-4 border-t border-border/50 text-[11px] text-muted/70">
      Not affiliated with or endorsed by Rockstar Games, Take-Two Interactive,
      or Cfx.re.
    </p>
  </div>
</footer>
